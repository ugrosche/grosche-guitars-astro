---
import { getCollection, render } from 'astro:content';
import ProjectDetail from '../../components/ProjectDetail.astro';

export async function getStaticPaths() {
  const workshop = await getCollection('workshop');

  return workshop.map((item) => ({
    params: {
      slug: item.id
    },
    props: {
      item
    }
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const images = import.meta.glob(
  '/src/assets/images/workshop/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const heroPath = item.data.hero?.src;

const heroImage = heroPath
  ? images[heroPath]?.default
  : undefined;
---

<ProjectDetail
  title={item.data.title}
  description={item.data.description}
  heroImage={heroImage}
  heroAlt={item.data.hero?.alt}
  heroDescription={item.data.hero?.description}
  backHref={`${import.meta.env.BASE_URL}werkstatt/`}
  backLabel="Zurück zur Werkstatt"
>

  <Content />

</ProjectDetail>
