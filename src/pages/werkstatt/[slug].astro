---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Head from '../../components/Head.astro';

export async function getStaticPaths() {
  const workshop = await getCollection('workshop');

  return workshop.map((item) => ({
    params: {
      slug: item.id
    },
    props: {
      item
    }
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const images = import.meta.glob(
  '/src/assets/images/workshop/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const heroPath = item.data.hero?.src;

const heroImage = heroPath
  ? images[heroPath]?.default
  : undefined;
---

<html lang="de">
  <head>
    <Head
      title={`${item.data.title} | Grosche Guitars`}
      description={item.data.description}
    />
  </head>

  <body>
    <main class="workshop-detail">

      <a
        class="back-link"
        href={`${import.meta.env.BASE_URL}werkstatt/`}
      >
        ← Zurück zur Werkstatt
      </a>

      <article>

        <header class="workshop-header">
          <h1>{item.data.title}</h1>

          {item.data.description && (
            <p class="workshop-description">
              {item.data.description}
            </p>
          )}
        </header>

        {heroImage && (
          <figure class="workshop-hero">
            <Image
              src={heroImage}
              alt={item.data.hero?.alt || item.data.title}
              widths={[600, 900, 1200, 1600]}
              sizes="(max-width: 900px) 100vw, 1200px"
            />

            {item.data.hero?.description && (
              <figcaption>
                {item.data.hero.description}
              </figcaption>
            )}
          </figure>
        )}

        <div class="workshop-content">
          <Content />
        </div>

      </article>

    </main>
  </body>
</html>

<style>
  .workshop-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: inherit;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .workshop-header {
    margin-bottom: 2rem;
  }

  .workshop-header h1 {
    margin-bottom: 0.75rem;
  }

  .workshop-description {
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .workshop-hero {
    margin: 0 0 3rem;
  }

  .workshop-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .workshop-hero figcaption {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .workshop-content {
    max-width: 850px;
    line-height: 1.7;
  }

  .workshop-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .workshop-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .workshop-content :global(p) {
    margin: 0 0 1.25rem;
  }

  @media (max-width: 700px) {
    .workshop-detail {
      padding: 1.25rem 1rem 3rem;
    }

    .workshop-description {
      font-size: 1.05rem;
    }
  }
</style>
