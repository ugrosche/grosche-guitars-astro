---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/guitars.css';

const workshop = await getCollection('workshop');
workshop.sort((a, b) => {
return (a.data.order ?? 999) - (b.data.order ?? 999);
});

const images = import.meta.glob(
  '/src/assets/images/workshop/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const base = import.meta.env.BASE_URL;

function baseUrl(path) {
  return (
    base.replace(/\/$/, '') +
    '/' +
    path.replace(/^\//, '')
  );
}

const projects = workshop.map((item) => {
  const heroPath = item.data.hero?.src;

  const heroImage = heroPath
    ? images[heroPath]?.default
    : undefined;

  return {
    item,
    heroImage,
    href: baseUrl(`/werkstatt/${item.id}/`)
  };
});
---

<!doctype html>

<html lang="de">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <Head
      title="Werkstatt | Grosche Guitars"
      description="Selbstgebaute Vorrichtungen und Hilfsmittel für den Gitarrenbau."
    />
  </head>

  <body>

    <Header />

    <main>

      <h1>Werkstatt</h1>

      <p class="intro">
        Selbstgebaute Vorrichtungen und Hilfsmittel, die in meiner Werkstatt
        beim Gitarrenbau zum Einsatz kommen.
      </p>

      <div class="guitar-grid">

        {projects.map(({ item, heroImage, href }) => (

          <article class="guitar-card workshop-card">

            {heroImage && (

              <a href={href} class="workshop-image-link">

                <div class="card-image workshop-card-image">

                  <Image
                    src={heroImage}
                    alt={item.data.hero?.alt || item.data.title}
                    width={400}
                    height={300}
                    fit="cover"
                    class="card-image-img"
                    loading="lazy"
                  />

                </div>

              </a>

            )}

            <div class="card-content">

              <h2>
                {item.data.title}
              </h2>

              {item.data.description && (

                <p class="description">
                  {item.data.description}
                </p>

              )}

              <a href={href} class="card-link">
                Projekt ansehen →
              </a>

            </div>

          </article>

        ))}

      </div>

    </main>

    <Footer />

  </body>

</html>

<style is:global>

.workshop-card-image {
  aspect-ratio: 4 / 3;
}

.workshop-image-link {
  display: block;
  width: 100%;
  color: inherit;
  text-decoration: none;
}

.workshop-image-link:hover .card-image-img {
  transform: scale(1.015);
}

</style>
