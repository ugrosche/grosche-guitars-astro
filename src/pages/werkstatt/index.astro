---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/guitars.css';

const workshop = await getCollection('workshop');

const images = import.meta.glob(
  '/src/assets/images/workshop/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const base = import.meta.env.BASE_URL;

function baseUrl(path) {
  return (
    base.replace(/\/$/, '') +
    '/' +
    path.replace(/^\//, '')
  );
}

const projects = workshop.map((item) => {
  const heroPath = item.data.hero?.src;

  const heroImage = heroPath
    ? images[heroPath]?.default
    : undefined;

  return {
    item,
    heroImage,
    href: baseUrl(`/werkstatt/${item.id}/`)
  };
});
---

<!doctype html>

<html lang="de">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <Head
      title="Werkstatt | Grosche Guitars"
      description="Selbstgebaute Vorrichtungen und Hilfsmittel für den Gitarrenbau."
    />
  </head>

  <body>

    <Header />

    <main>

      <h1>Werkstatt</h1>

      <p class="intro">
        Selbstgebaute Vorrichtungen und Hilfsmittel, die in meiner Werkstatt
        beim Gitarrenbau zum Einsatz kommen.
      </p>

      <div class="guitar-grid workshop-grid">

        {projects.map(({ item, heroImage, href }) => (

          <article class="guitar-card workshop-card">

            {heroImage && (

              <div class="workshop-card-image">

                <Image
                  src={heroImage}
                  alt={item.data.hero?.alt || item.data.title}
                  width={400}
                  height={300}
                  fit="cover"
                  class="workshop-card-photo"
                  loading="lazy"
                />

              </div>

            )}

            <div class="guitar-card-content">

              <h2>
                {item.data.title}
              </h2>

              {item.data.description && (

                <p>
                  {item.data.description}
                </p>

              )}

              <a href={href} class="card-link">
                Projekt ansehen →
              </a>

            </div>

          </article>

        ))}

      </div>

    </main>

    <Footer />

  </body>

</html>

<style is:global>

.workshop-card-image {
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 12px;
}

.workshop-card-photo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.workshop-card .guitar-card-content h2 {
font-size: 1.35rem;
}

</style>
