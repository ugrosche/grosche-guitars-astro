---
import { getCollection } from 'astro:content';

import '../../styles/guitars.css';
import Footer from '../../components/Footer.astro';

const guitars = await getCollection('guitars');
const base = import.meta.env.BASE_URL;

function pageUrl(id) {
  return (
    base.replace(/\/$/, '') +
    '/gitarren/' +
    id +
    '/'
  );
}

function imageUrl(src) {
  if (!src) return '';

  return (
    base.replace(/\/$/, '') +
    '/' +
    src.replace(/^\//, '')
  );
}

const sortedGuitars = [...guitars].sort(
  (a, b) => (b.data.year || 0) - (a.data.year || 0)
);
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Gitarren | Grosche Guitars</title>
</head>

<body>
  <main>

    <h1>Meine Gitarren</h1>

    <p class="intro">
      Eine Auswahl meiner selbst gebauten Gitarren und ihrer Entstehung.
    </p>

    <div class="guitar-grid">

      {sortedGuitars.map((guitar) => (
        <article class="guitar-card">

          <a href={pageUrl(guitar.id)}>

            {guitar.data.hero?.src && (
              <img
                src={imageUrl(guitar.data.hero.src)}
                alt={guitar.data.hero.alt || guitar.data.title}
                loading="lazy"
              />
            )}

            <div class="card-content">

              <h2>{guitar.data.title}</h2>

              {guitar.data.year && (
                <p class="year">
                  Baujahr {guitar.data.year}
                </p>
              )}

              {guitar.data.description && (
                <p class="description">
                  {guitar.data.description}
                </p>
              )}

            </div>

          </a>

        </article>
      ))}

    </div>

  </main>
<Footer />
</body>
</html>
