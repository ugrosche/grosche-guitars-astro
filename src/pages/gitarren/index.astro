---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Head from '../../components/Head.astro';
import '../../styles/guitars.css';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const guitars = await getCollection('guitars');
const base = import.meta.env.BASE_URL;

/*
 * Alle Gitarrenbilder unter src/assets/images/guitars
 * werden Astro beim Build bekannt gemacht.
 */
const images = import.meta.glob(
  '/src/assets/images/guitars/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  {
    eager: true,
    import: 'default'
  }
);

function pageUrl(id) {
  return (
    base.replace(/\/$/, '') +
    '/gitarren/' +
    id +
    '/'
  );
}

/*
 * Sveltia speichert z.B.:
 *
 * /src/assets/images/guitars/kuu/01.jpg
 *
 * Dieser Pfad entspricht direkt dem Schlüssel
 * in unserem import.meta.glob().
 */
function getImage(src) {
  if (!src) return undefined;

  return images[src];
}

const sortedGuitars = [...guitars].sort(
  (a, b) => (b.data.year || 0) - (a.data.year || 0)
);
---

<!doctype html>
<html lang="de">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Gitarren | Grosche Guitars</title>
  <Head title="Gitarren | Grosche Guitars" />
</head>

<body>

<Header />

<main>

  <h1>Meine Gitarren</h1>

  <p class="intro">
    Eine Auswahl meiner selbst gebauten Gitarren und ihrer Entstehung.
  </p>

  <div class="guitar-grid">

    {sortedGuitars.map((guitar) => {

      const heroImage = getImage(guitar.data.hero?.src);

      return (
        <article class="guitar-card">

          <a href={pageUrl(guitar.id)}>

    <div class="card-image">

  {heroImage && (
    <Image
      src={heroImage}
      alt={guitar.data.hero?.alt || guitar.data.title}
      widths={[400, 600, 800, 1200]}
      sizes="(max-width: 600px) calc(100vw - 32px), 520px"
      loading="lazy"
      class="card-image-img"
    />
  )}

</div>

<div class="card-content">
              <h2>
                {guitar.data.title}
              </h2>

              {guitar.data.year && (
                <p class="year">
                  Baujahr {guitar.data.year}
                </p>
              )}

              {guitar.data.description && (
                <p class="description">
                  {guitar.data.description}
                </p>
              )}

              <span class="card-link">
                Baubericht ansehen →
              </span>

            </div>

          </a>

        </article>
      );
    })}

  </div>

</main>

<Footer />

</body>

</html>
