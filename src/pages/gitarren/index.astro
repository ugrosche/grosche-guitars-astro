---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Head from '../../components/Head.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

import '../../styles/guitars.css';

const guitars = await getCollection('guitars');
const base = import.meta.env.BASE_URL;

function pageUrl(id) {
  return (
    base.replace(/\/$/, '') +
    '/gitarren/' +
    id +
    '/'
  );
}

/*
  Alle Gitarrenbilder aus src/assets/images/guitars
  werden Astro bekannt gemacht.
*/
const images = import.meta.glob(
  '/src/assets/images/guitars/**/*.{jpg,jpeg,png,webp}',
  {
    eager: true,
    import: 'default'
  }
);

function getImage(src) {
  if (!src) return undefined;

  /*
    Beispiel aus Markdown:
    images/guitars/kuun/hero.jpg

    wird zu:
    /src/assets/images/guitars/kuun/hero.jpg
  */
  const cleanSrc = src.replace(/^\/?images\/guitars\//, '');

  return images[
    `/src/assets/images/guitars/${cleanSrc}`
  ];
}

const sortedGuitars = [...guitars].sort(
  (a, b) => (b.data.year || 0) - (a.data.year || 0)
);
---

<!doctype html>
<html lang="de">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Gitarren | Grosche Guitars</title>
  <Head title="Gitarren | Grosche Guitars" />
</head>

<body>

<Header />

<main>

  <h1>Meine Gitarren</h1>

  <p class="intro">
    Eine Auswahl meiner selbst gebauten Gitarren und ihrer Entstehung.
  </p>

  <div class="guitar-grid">

    {sortedGuitars.map((guitar) => {

      const heroImage = getImage(guitar.data.hero?.src);

      return (
        <article class="guitar-card">

          <a href={pageUrl(guitar.id)}>

            {heroImage && (
              <Image
                src={heroImage}
                alt={guitar.data.hero?.alt || guitar.data.title}
                widths={[400, 600, 800]}
                sizes="(max-width: 700px) 100vw, 400px"
                loading="lazy"
              />
            )}

            <div class="card-content">

              <h2>
                {guitar.data.title}
              </h2>

              {guitar.data.year && (
                <p class="year">
                  Baujahr {guitar.data.year}
                </p>
              )}

              {guitar.data.description && (
                <p class="description">
                  {guitar.data.description}
                </p>
              )}

              <span class="card-link">
                Baubericht ansehen →
              </span>

            </div>

          </a>

        </article>
      );
    })}

  </div>

</main>

<Footer />

</body>
</html>
