---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id.replace(/\.md$/, '')
    },
    props: {
      guitar: guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
const base = import.meta.env.BASE_URL;

const heroSrc = data.hero?.src
  ? `${base}${data.hero.src.replace(/^\//, '')}`
  : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>{data.title} | Grosche Guitars</title>
  </head>

  <body>
    <main>
      <p><a href="/">Zur Startseite</a></p>

      <h1>{data.title}</h1>

      <p>Baujahr: {data.year}</p>

  {heroSrc && (
    <img
    class="hero"
    src={heroSrc}
    alt={data.hero.alt || data.title}
    loading="lazy"
    / >
  )}


      <p>{data.description}</p>
    </main>

    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        margin: 0;
        color: #222;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      .hero {
        display: block;
        width: 100%;
        height: auto;
        margin: 30px 0;
      }
    </style>
  </body>
</html>
