---
import { getCollection } from 'astro:content';

import '../../styles/guitars.css';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
const base = import.meta.env.BASE_URL;

function imageUrl(src) {
  if (!src) return '';

  return (
    base.replace(/\/$/, '') +
    '/' +
    src.replace(/^\//, '')
  );
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{data.title} | Grosche Guitars</title>

  </head>

<body>
  <main>

<a class="back" href={base} >
← Zur Startseite
</a>
    <h1>{data.title}</h1>

    {data.year && (
      <p class="year">
        Baujahr: {data.year}
      </p>
    )}

{data.hero?.src && (
  <img
    src={imageUrl(data.hero.src)}
    alt={data.hero.alt || data.title}
    class="hero"
    loading="lazy"
  />
)}

    {data.description && (
      <p class="description">
        {data.description}
      </p>
    )}

    {data.build_steps?.length > 0 && (
      <section class="build">
        <h2>Der Bau</h2>

        {data.build_steps.map((step) => (
          <article class="build-step">

            <h3>{step.title}</h3>

            {step.description && (
              <p class="step-description">
                {step.description}
              </p>
            )}


{step.images?.length > 0 && (
  <div
    class="build-images-shell"
    data-carousel={step.display === 'carousel' ? '' : undefined}
  >

    {step.display === 'carousel' && step.images.length > 1 && (
      <div class="carousel-controls">
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-prev
          aria-label="Vorheriges Bild"
        >
          ‹
        </button>

        <div class="carousel-counter" aria-live="polite">
          Bild <span data-carousel-current>1</span>
          von <span>{step.images.length}</span>
        </div>

        <button
          type="button"
          class="carousel-arrow"
          data-carousel-next
          aria-label="Nächstes Bild"
        >
          ›
        </button>
      </div>
    )}

    <div
      class={'build-images build-images-' + (step.display || 'gallery')}
      data-carousel-track={step.display === 'carousel' ? '' : undefined}
    >

      {step.images.map((image, imageIndex) => (
        <figure
          class="build-image"
          data-carousel-slide={step.display === 'carousel' ? '' : undefined}
        >

<button
  type="button"
  class="lightbox-trigger"
  data-lightbox-trigger
  data-lightbox-src={imageUrl(image.src)}
  data-lightbox-alt={image.alt || image.caption || step.title}
  data-lightbox-caption={image.caption || ''}
  aria-label={`Bild groß anzeigen: ${image.alt || image.caption || step.title}`}
>

  <img
    src={imageUrl(image.src)}
    alt={image.alt || image.caption || step.title}
    loading="lazy"
  />

</button>
          {image.caption && (
            <figcaption>
              {image.caption}
            </figcaption>
          )}

        </figure>
      ))}

    </div>

    {step.display === 'carousel' && step.images.length > 1 && (
      <div
        class="carousel-dots"
        aria-label="Bildauswahl"
      >
        {step.images.map((image, imageIndex) => (
          <button
            type="button"
            class="carousel-dot"
            data-carousel-dot
            data-index={imageIndex}
            aria-label={`Bild ${imageIndex + 1} anzeigen`}
            aria-current={imageIndex === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
    )}

  </div>
)}

          </article>
        ))}

      </section>
    )}

  </main>

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    const previousButton = carousel.querySelector('[data-carousel-prev]');
    const nextButton = carousel.querySelector('[data-carousel-next]');
    const currentCounter = carousel.querySelector('[data-carousel-current]');
    const dots = Array.from(
      carousel.querySelectorAll('[data-carousel-dot]')
    );
    const slides = Array.from(
      carousel.querySelectorAll('[data-carousel-slide]')
    );

    if (!(track instanceof HTMLElement) || slides.length === 0) {
      return;
    }

    let currentIndex = 0;
    let scrollTimer;

    function updateControls(index) {
      currentIndex = Math.max(
        0,
        Math.min(index, slides.length - 1)
      );

      if (currentCounter) {
        currentCounter.textContent = String(currentIndex + 1);
      }

      if (previousButton instanceof HTMLButtonElement) {
        previousButton.disabled = currentIndex === 0;
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = currentIndex === slides.length - 1;
      }

      dots.forEach((dot, dotIndex) => {
        dot.setAttribute(
          'aria-current',
          dotIndex === currentIndex ? 'true' : 'false'
        );
      });
    }

    function goToSlide(index) {
      const target = slides[index];

      if (!(target instanceof HTMLElement)) {
        return;
      }

      track.scrollTo({
        left: target.offsetLeft,
        behavior: 'smooth'
      });

      updateControls(index);
    }

    previousButton?.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
    });

    nextButton?.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToSlide(index);
      });
    });

    track.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer);

      scrollTimer = window.setTimeout(() => {
        let closestIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        slides.forEach((slide, index) => {
          if (!(slide instanceof HTMLElement)) {
            return;
          }

          const distance = Math.abs(
            slide.offsetLeft - track.scrollLeft
          );

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        updateControls(closestIndex);
      }, 80);
    });

    updateControls(0);
  });
</script>

</body></html>
