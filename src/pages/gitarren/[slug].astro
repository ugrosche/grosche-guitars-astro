---
import { getCollection } from 'astro:content';

import '../../styles/guitars.css';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
const base = import.meta.env.BASE_URL;

function imageUrl(src) {
  if (!src) return '';

  return (
    base.replace(/\/$/, '') +
    '/' +
    src.replace(/^\//, '')
  );
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{data.title} | Grosche Guitars</title>

  </head>

<body>
  <>

<a class="back" href={base} >
← Zur Startseite
</a>
    <h1>{data.title}</h1>

    {data.year && (
      <p class="year">
        Baujahr: {data.year}
      </p>
    )}

{data.hero?.src && (
  <img
    src={imageUrl(data.hero.src)}
    alt={data.hero.alt || data.title}
    class="hero"
    loading="lazy"
  />
)}

    {data.description && (
      <p class="description">
        {data.description}
      </p>
    )}

    {data.build_steps?.length > 0 && (
      <section class="build">
        <h2>Der Bau</h2>

        {data.build_steps.map((step, stepIndex) => (
          <article class="build-step">

            <h3>{step.title}</h3>

            {step.description && (
              <p class="step-description">
                {step.description}
              </p>
            )}


{step.images?.length > 0 && (
  <div
    class="build-images-shell"
    data-carousel={step.display === 'carousel' ? '' : undefined}
  >

    {step.display === 'carousel' && step.images.length > 1 && (
      <div class="carousel-controls">
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-prev
          aria-label="Vorheriges Bild"
        >
          ‹
        </button>

        <div class="carousel-counter" aria-live="polite">
          Bild <span data-carousel-current>1</span>
          von <span>{step.images.length}</span>
        </div>

        <button
          type="button"
          class="carousel-arrow"
          data-carousel-next
          aria-label="Nächstes Bild"
        >
          ›
        </button>
      </div>
    )}

    <div
      class={'build-images build-images-' + (step.display || 'gallery')}
      data-carousel-track={step.display === 'carousel' ? '' : undefined}
    >

      {step.images.map((image, imageIndex) => (
        <figure
          class="build-image"
          data-carousel-slide={step.display === 'carousel' ? '' : undefined}
        >

<button
  type="button"
  class="lightbox-trigger"
  data-lightbox-trigger
  data-lightbox-group={`build-step-${stepIndex}`}
  data-lightbox-index={imageIndex}
  data-lightbox-src={imageUrl(image.src)}
  data-lightbox-alt={image.alt || image.caption || step.title}
  data-lightbox-caption={image.caption || ''}
  aria-label={`Bild groß anzeigen: ${image.alt || image.caption || step.title}`}
>

  <img
    src={imageUrl(image.src)}
    alt={image.alt || image.caption || step.title}
    loading="lazy"
  />

</button>
          {image.caption && (
            <figcaption>
              {image.caption}
            </figcaption>
          )}

        </figure>
      ))}

    </div>

    {step.display === 'carousel' && step.images.length > 1 && (
      <div
        class="carousel-dots"
        aria-label="Bildauswahl"
      >
        {step.images.map((image, imageIndex) => (
          <button
            type="button"
            class="carousel-dot"
            data-carousel-dot
            data-index={imageIndex}
            aria-label={`Bild ${imageIndex + 1} anzeigen`}
            aria-current={imageIndex === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
    )}

  </div>
)}

          </article>
        ))}

      </section>
    )}

  </main>

<dialog
  class="lightbox"
  data-lightbox
  aria-label="Bildvergrößerung"
>

  <div class="lightbox-panel">

    <button
      type="button"
      class="lightbox-close"
      data-lightbox-close
      aria-label="Bildansicht schließen"
    >
      ×
    </button>

    <button
      type="button"
      class="lightbox-nav lightbox-nav-prev"
      data-lightbox-prev
      aria-label="Vorheriges Bild"
    >
      ‹
    </button>

    <img
      class="lightbox-image"
      data-lightbox-image
      src=""
      alt=""
    />

    <button
      type="button"
      class="lightbox-nav lightbox-nav-next"
      data-lightbox-next
      aria-label="Nächstes Bild"
    >
      ›
    </button>

    <div class="lightbox-info">

      <p
        class="lightbox-counter"
        data-lightbox-counter
        aria-live="polite"
      >
        Bild 1 von 1
      </p>

      <p
        class="lightbox-caption"
        data-lightbox-caption
        hidden
      >
      </p>

    </div>

  </div>

</dialog>
<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    const previousButton = carousel.querySelector('[data-carousel-prev]');
    const nextButton = carousel.querySelector('[data-carousel-next]');
    const currentCounter = carousel.querySelector('[data-carousel-current]');
    const dots = Array.from(
      carousel.querySelectorAll('[data-carousel-dot]')
    );
    const slides = Array.from(
      carousel.querySelectorAll('[data-carousel-slide]')
    );

    if (!(track instanceof HTMLElement) || slides.length === 0) {
      return;
    }

    let currentIndex = 0;
    let scrollTimer;

    function updateControls(index) {
      currentIndex = Math.max(
        0,
        Math.min(index, slides.length - 1)
      );

      if (currentCounter) {
        currentCounter.textContent = String(currentIndex + 1);
      }

      if (previousButton instanceof HTMLButtonElement) {
        previousButton.disabled = currentIndex === 0;
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = currentIndex === slides.length - 1;
      }

      dots.forEach((dot, dotIndex) => {
        dot.setAttribute(
          'aria-current',
          dotIndex === currentIndex ? 'true' : 'false'
        );
      });
    }

    function goToSlide(index) {
      const target = slides[index];

      if (!(target instanceof HTMLElement)) {
        return;
      }

      track.scrollTo({
        left: target.offsetLeft,
        behavior: 'smooth'
      });

      updateControls(index);
    }

    previousButton?.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
    });

    nextButton?.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToSlide(index);
      });
    });

    track.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer);

      scrollTimer = window.setTimeout(() => {
        let closestIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        slides.forEach((slide, index) => {
          if (!(slide instanceof HTMLElement)) {
            return;
          }

          const distance = Math.abs(
            slide.offsetLeft - track.scrollLeft
          );

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        updateControls(closestIndex);
      }, 80);
    });

    updateControls(0);
  });
</script>

<script>
  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImage = document.querySelector(
    '[data-lightbox-image]'
  );
  const lightboxCaption = document.querySelector(
    '[data-lightbox-caption]'
  );
  const lightboxCounter = document.querySelector(
    '[data-lightbox-counter]'
  );
  const lightboxClose = document.querySelector(
    '[data-lightbox-close]'
  );
  const lightboxPrevious = document.querySelector(
    '[data-lightbox-prev]'
  );
  const lightboxNext = document.querySelector(
    '[data-lightbox-next]'
  );

  const allLightboxTriggers = Array.from(
    document.querySelectorAll('[data-lightbox-trigger]')
  );

  if (
    lightbox instanceof HTMLDialogElement &&
    lightboxImage instanceof HTMLImageElement &&
    lightboxCaption instanceof HTMLElement &&
    lightboxCounter instanceof HTMLElement
  ) {
    let currentGroup = [];
    let currentIndex = 0;

    function showLightboxImage(index) {
      if (currentGroup.length === 0) {
        return;
      }

      currentIndex = Math.max(
        0,
        Math.min(index, currentGroup.length - 1)
      );

      const trigger = currentGroup[currentIndex];

      if (!(trigger instanceof HTMLElement)) {
        return;
      }

      const src = trigger.dataset.lightboxSrc || '';
      const alt = trigger.dataset.lightboxAlt || '';
      const caption = trigger.dataset.lightboxCaption || '';

      lightboxImage.src = src;
      lightboxImage.alt = alt;

      lightboxCaption.textContent = caption;
      lightboxCaption.hidden = caption.length === 0;

      lightboxCounter.textContent =
        `Bild ${currentIndex + 1} von ${currentGroup.length}`;

      if (lightboxPrevious instanceof HTMLButtonElement) {
        lightboxPrevious.disabled = currentIndex === 0;
      }

      if (lightboxNext instanceof HTMLButtonElement) {
        lightboxNext.disabled =
          currentIndex === currentGroup.length - 1;
      }
    }

    allLightboxTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (!(trigger instanceof HTMLElement)) {
          return;
        }

        const groupName = trigger.dataset.lightboxGroup || '';

        currentGroup = allLightboxTriggers.filter((item) => {
          return (
            item instanceof HTMLElement &&
            item.dataset.lightboxGroup === groupName
          );
        });

        currentIndex = currentGroup.indexOf(trigger);

        showLightboxImage(currentIndex);
        lightbox.showModal();
      });
    });

    lightboxPrevious?.addEventListener('click', () => {
      showLightboxImage(currentIndex - 1);
    });

    lightboxNext?.addEventListener('click', () => {
      showLightboxImage(currentIndex + 1);
    });

    lightboxClose?.addEventListener('click', () => {
      lightbox.close();
    });

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        lightbox.close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox.open) {
        return;
      }

      if (event.key === 'ArrowLeft') {
        showLightboxImage(currentIndex - 1);
      }

      if (event.key === 'ArrowRight') {
        showLightboxImage(currentIndex + 1);
      }
    });

    lightbox.addEventListener('close', () => {
      lightboxImage.src = '';
      lightboxImage.alt = '';
      lightboxCaption.textContent = '';
      lightboxCaption.hidden = true;
      lightboxCounter.textContent = '';
      currentGroup = [];
      currentIndex = 0;
    });
  }
</script>

</body></html>
