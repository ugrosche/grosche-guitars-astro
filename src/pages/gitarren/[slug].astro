---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: { slug: guitar.id.replace(/\.md$/, '') },
    props: { guitar }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.title} | Grosche Guitars</title>
  </head>

  <body>
    <main>
      <a href="/">Zurück zur Startseite</a>

      <h1>{data.title}</h1>

      {data.year && <p>Baujahr: {data.year}</p>}

      {data.hero?.src && (
        {data.hero.src}
      )}

      {data.description && (
        <p>{data.description}</p>
      )}
    </main>
  </body>
</html>
