---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
const base = import.meta.env.BASE_URL;

function imageUrl(src) {
  if (!src) return '';

  return base.replace(/\/$/, '') + '/' + src.replace(/^\//, '');
}
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <title>{data.title} | Grosche Guitars</title>
</head>

<body>

  <main>

    <p><a href={base}>Zur Startseite</a></h1>{data.title}</h1>

    <p>Baujahr: {data.year}</p>

    {data.hero?.src ? (
      {imageUrl(data.hero.src)}        alt={data.hero?.alt || data.title}
        class="hero"
      />
    ) : null}

    <p>{data.description}</p>

  </main>

  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      color: #222;
    }

    main {
      max-width: 1000px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    .hero {
      display: block;
      width: 100%;
      height: auto;
      margin: 30px 0;
    }
  </style>

</body>
</html>
