---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
const base = import.meta.env.BASE_URL;

function imageUrl(src) {
  if (!src) return '';

  return (
    base.replace(/\/$/, '') +
    '/' +
    src.replace(/^\//, '')
  );
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{data.title} | Grosche Guitars</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: #222;
        background: #fff;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      h1 {
        margin-bottom: 0.25rem;
        font-size: 2.5rem;
      }

      .back {
        display: inline-block;
        margin-bottom: 2rem;
        color: #333;
        text-decoration: none;
      }

      .back:hover {
        text-decoration: underline;
      }

      .year {
        margin-top: 0.5rem;
        color: #666;
      }

      .hero {
        display: block;
        width: 100%;
        height: auto;
        max-height: 700px;
        margin: 30px 0;
        object-fit: contain;
        border-radius: 8px;
        background: #f5f5f5;
      }

      .description {
        font-size: 1.1rem;
        line-height: 1.7;
      }

      @media (max-width: 600px) {
        main {
          padding: 24px 16px 60px;
        }

        h1 {
          font-size: 2rem;
        }
      }

.spec-section,
.build-section {
  margin-top: 3rem;
}

.specifications {
  margin: 0;
}

.spec-row {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 20px;
  padding: 10px 0;
  border-bottom: 1px solid #ddd;
}

.spec-row dt {
  font-weight: bold;
}

.spec-row dd {
  margin: 0;
}

.build-step {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #ddd;
}

.build-step h3 {
  margin: 0 0 0.75rem;
}

.step-description {
  line-height: 1.7;
}

.build-images {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  margin-top: 1.5rem;
}

.build-image {
  margin: 0;
}

.build-image img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
}

.build-image figcaption {
  margin-top: 8px;
  color: #666;
  font-size: 0.9rem;
  line-height: 1.4;
}
    </style>
  </head>

  <body>
    <main>
<p>
  <a class="back" href={base}>/p>
</p>

      <h1>{data.title}</h1>

      {data.year && (
        <p class="year">
          Baujahr: {data.year}
        </p>
      )}

      {data.hero?.src && (
        <img
          class="hero"
          src={imageUrl(data.hero.src)}
           loading="eager"
        />
      )}

      {data.description && (
        <p class="description">
          {data.description}
        </p>
      )}

{data.specifications?.length > 0 && (
  <section class="spec-section">
    <h2>Technische Daten</h2>

    <dl class="specifications">
      {data.specifications.map((spec) => (
        <div class="spec-row">
          <dt>{spec.label}</dt>
          <dd>{spec.value}</dd>
        </div>
      ))}
    </dl>
  </section>
)}

{data.build_steps?.length > 0 && (
  <section class="build-section">
    <h2>Der Bau</h2>

    {data.build_steps.map((step) => (
      <article class="build-step">

        <h3>{step.title}</h3>

        {step.description && (
          <p class="step-description">
            {step.description}
          </p>
        )}

        {step.images?.length > 0 && (
          <div class="build-images">

{step.images.map((image) => (
  <figure class="build-image">
    <img
     src={imageUrl(image.src)}
alt={image.alt || image.caption || step.title}
      loading="lazy"
    />

    {image.caption && (
      <figcaption>
        {image.caption}
      </figcaption>
    )}
  </figure>
))}

          </div>
        )}

      </article>
    ))}
  </section>
)}

    </main>
  </body>
</html>
