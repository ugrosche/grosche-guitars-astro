---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id.replace(/\.md$/, '')
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;

const base = import.meta.env.BASE_URL;

const heroSrc = data.hero?.src
  ? `${base}${data.hero.src.replace(/^\//, '')}`
  : null;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.title} | Grosche Guitars</title>
  </head>

  <body>
    <main>
      <a href="/">Zurück zur Startseite</a>
<h1>{data.title}</h1>

{data.year && (
  <div class="year">
    Baujahr {data.year}
  </div>
)}

{data.hero?.src && (
  {`${base}${data.hero.src.replace(/^\//,}`}
    alt={data.hero.alt || data.title}
  />
)}

{data.description && (
  <div class="description">
    {data.description}
  </div>
)}
      {
        data.specifications?.length > 0 && (
          <section>
            <h2>Technische Daten</h2>

            <dl>
              {data.specifications.map((spec) => (
                <>
                  <dt>{spec.label}</dt>
                  <dd>{spec.value}</dd>
                </>
              ))}
            </dl>
          </section>
        )
      }

      {
        data.build_steps?.length > 0 && (
          <section>
            <h2>Der Bau</h2>

            {data.build_steps.map((step) => (
              <article>
                <h3>{step.title}</h3>

                {step.description && <p>{step.description}</p>}

                <div class="gallery">
                  {step.images?.map((image) => (
                    <figure>
                      {image.src}

                      {image.caption && (
                        <figcaption>{image.caption}</figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </article>
            ))}
          </section>
        )
      }

      {
        data.gallery?.length > 0 && (
          <section>
            <h2>Galerie</h2>

            <div class="gallery">
              {data.gallery.map((image) => (
                <figure>
                  {image.src}

                  {image.caption && (
                    <figcaption>{image.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          </section>
        )
      }
    </main>

    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: #222;
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      h1 {
        font-size: 2.5rem;
      }

      h2 {
        margin-top: 3rem;
      }

      article {
        margin-top: 2rem;
      }

      .hero {
        display: block;
        width: 100%;
        max-height: 650px;
        object-fit: cover;
        margin: 2rem 0;
      }

      dl {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 0.5rem 1rem;
      }

      dt {
        font-weight: bold;
      }

      dd {
        margin: 0;
      }

      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-top: 1.5rem;
      }

      figure {
        margin: 0;
      }

      figure img {
        display: block;
        width: 100%;
        height: 260px;
        object-fit: cover;
      }

      figcaption {
        margin-top: 0.5rem;
        color: #666;
      }
    </style>
  </body>
</html>
