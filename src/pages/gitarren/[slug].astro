---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
{data.hero?.src ? (
  {imageUrl(data.hero.src)}    alt={data.hero.alt || data.title}
    class="hero"
    loading="lazy"
  />
) : null}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.title} | Grosche Guitars</title>
  </head>

  <body>
    <main>
      <p>
        {base}Zur Startseite</a>
      </p>

      <h1>{data.title}</h1>

      {data.year && (
        <p class="year">
          Baujahr: {data.year}
        </p>
      )}

{data.hero?.src && (
  <img
    class="hero"
  }    alt={data.hero.alt || data.title}
    loading="lazy"
  />
)}

      {data.description && (
        <p class="description">
          {data.description}
        </p>
      )}
    </main>

    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: #222;
        background: #fff;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      h1 {
        margin-bottom: 0.25rem;
        font-size: 2.5rem;
      }

      .year {
        margin-top: 0.5rem;
        color: #666;
      }


  .hero {
    display: block;
    width: 100%;
    height: auto;
    margin: 30px 0;
  }


      .description {
        font-size: 1.1rem;
        line-height: 1.7;
      }

      @media (max-width: 600px) {
        main {
          padding: 24px 16px 60px;
        }

        h1 {
          font-size: 2rem;
        }
      }
    </style>
  </body>
</html>
