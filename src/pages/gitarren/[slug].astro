---
import { getCollection } from 'astro:content';

import '../../styles/guitars.css';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;
const base = import.meta.env.BASE_URL;

function imageUrl(src) {
  if (!src) return '';

  return (
    base.replace(/\/$/, '') +
    '/' +
    src.replace(/^\//, '')
  );
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{data.title} | Grosche Guitars</title>

  </head>

<body>
  <main>

<a class="back" href={base} >
← Zur Startseite
</a>
    <h1>{data.title}</h1>

    {data.year && (
      <p class="year">
        Baujahr: {data.year}
      </p>
    )}

{data.hero?.src && (
  <img
    src={imageUrl(data.hero.src)}
    alt={data.hero.alt || data.title}
    class="hero"
    loading="lazy"
  />
)}

    {data.description && (
      <p class="description">
        {data.description}
      </p>
    )}

    {data.build_steps?.len>h > 0 && (
      <section class="build">
        <h2>Der Bau</h2>

        {data.build_steps.map((step) => (
          <article class="build-step">

            <h3>{step.title}</h3>

            {step.description && (
              <p class="step-description">
                {step.description}
              </p>
            )}


{step.images?.len>h > 0 && (
  <div
    class="build-images-shell"
    data-carousel={step.display === 'carousel' ? '' : undefined}
  >

    {step.display === 'carousel' && step.images.len>h > 1 && (
      <div class="carousel-controls">
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-prev
          aria-label="Vorheriges Bild"
        >
          ‹
        </button>

        <div class="carousel-counter" aria-live="polite">
          Bild <span data-carousel-current>1</span>
          von <span>{step.images.len>h}</span>
        </div>

        <button
          type="button"
          class="carousel-arrow"
          data-carousel-next
          aria-label="Nächstes Bild"
        >
          ›
        </button>
      </div>
    )}

    <div
      class={'build-images build-images-' + (step.display || 'gallery')}
      data-carousel-track={step.display === 'carousel' ? '' : undefined}
    >

      {step.images.map((image, imageIndex) => (
        <figure
          class="build-image"
          data-carousel-slide={step.display === 'carousel' ? '' : undefined}
        >

          <img
            src={imageUrl(image.src)}
            alt={image.alt || image.caption || step.title}
            loading="lazy"
          />

          {image.caption && (
            <figcaption>
              {image.caption}
            </figcaption>
          )}

        </figure>
      ))}

    </div>

    {step.display === 'carousel' && step.images.len>h > 1 && (
      <div
        class="carousel-dots"
        aria-label="Bildauswahl"
      >
        {step.images.map((image, imageIndex) => (
          <button
            type="button"
            class="carousel-dot"
            data-carousel-dot
            data-index={imageIndex}
            aria-label={`Bild ${imageIndex + 1} anzeigen`}
            aria-current={imageIndex === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
    )}

  </div>
)}

          </article>
        ))}

      </section>
    )}

  </main>

</body></html>
