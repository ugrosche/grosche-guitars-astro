---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../components/ProjectDetail.astro';

export async function getStaticPaths() {
  const guitars = await getCollection('guitars');

  return guitars.map((guitar) => ({
    params: {
      slug: guitar.id
    },
    props: {
      guitar
    }
  }));
}

const { guitar } = Astro.props;
const data = guitar.data;

const images = import.meta.glob(
  '/src/assets/images/guitars/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const heroPath = data.hero?.src;

const heroImage = heroPath
  ? images[heroPath]?.default
  : undefined;

const base = import.meta.env.BASE_URL;

function baseUrl(path) {
  return (
    base.replace(/\/$/, '') +
    '/' +
    path.replace(/^\//, '')
  );
}
---

<ProjectDetail
  title={data.title}
  description={data.description}
  year={data.year}
  heroImage={heroImage}
  heroAlt={data.hero?.alt}
  heroDescription={data.hero?.description}
  backHref={baseUrl('/gitarren/')}
  backLabel="Alle Gitarren"
  buildTitle="Der Bau"
  buildSteps={data.build_steps || []}
  imageModules={images}
>

</ProjectDetail>
