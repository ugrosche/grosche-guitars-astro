---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../styles/guitars.css";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
const title = "Grosche Guitars – Gitarrenbau mit eigener Handschrift";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const guitarUrl = base + "/gitarren/";
const processUrl = base + "/bauprozess/";
const workshopUrl = base + "/werkstatt/";
const guitars = await getCollection("guitars");
const featuredGuitar = [...guitars].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))[0];
const imageFiles = import.meta.glob("/src/assets/images/guitars/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}", { eager: true, import: "default" });
const finishedImage = featuredGuitar?.data.hero?.src ? imageFiles[featuredGuitar.data.hero.src] : undefined;
const processStep = featuredGuitar?.data.build_steps?.find((step) => step.display !== "gallery" && step.images?.length);
const processImage = processStep?.images?.[0]?.src ? imageFiles[processStep.images[0].src] : undefined;
---
<!doctype html>
<html lang="de">
  <head><Head title={title} description="Handgebaute Gitarren, dokumentierte Bauprozesse und praktische Lösungen aus der Werkstatt von Grosche Guitars." /></head>
  <body>
    <Header />
    <main class="home home-redesign">
      <section class="home-hero redesign-hero">
        <div class="hero-copy">
          <p class="eyebrow">Gitarrenbau · Handwerk · Leidenschaft</p>
          <h1>Instrumente mit<br /><em>eigener Handschrift.</em></h1>
          <p class="home-intro">Gitarren entstehen nicht von der Stange. Hier geht es um Holz, Konstruktion, Klang und den Weg vom ersten Entwurf bis zum fertigen Instrument.</p>
          <div class="home-buttons">
            <a href={guitarUrl} class="home-button">Gitarren entdecken <span aria-hidden="true">↗</span></a>
            <a href={processUrl} class="home-button home-button-secondary">Einblicke in den Bau</a>
          </div>
          <p class="hero-note">Eine private Gitarrenbauwerkstatt – dokumentiert mit Bildern, Ideen und Erfahrungen.</p>
        </div>
        <figure class="home-image redesign-hero-image">
          <img src={base + "/images/home/hero.jpg"} alt="Gitarren aus der Werkstatt von Grosche Guitars" loading="eager" fetchpriority="high" />
        </figure>
      </section>

      <section class="home-intro-band">
        <p class="eyebrow">Willkommen bei Grosche Guitars</p>
        <h2>Gute Instrumente beginnen mit Neugier.</h2>
        <p>Mich interessiert nicht nur, wie eine Gitarre am Ende aussieht und klingt. Ebenso spannend ist, warum eine Konstruktion funktioniert, welche Materialien sich bewähren und welche Lösung sich beim Bauen als die richtige erweist.</p>
      </section>

      <section class="home-featured-paths" aria-label="Gitarren und Bauprozess">
        <article class="home-feature home-feature-instruments">
          <a class="home-feature-image" href={guitarUrl}>
            {finishedImage && <Image src={finishedImage} alt={featuredGuitar?.data.hero?.alt || featuredGuitar?.data.title || "Fertige Gitarre"} widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 58vw" loading="lazy" />}
          </a>
          <div class="home-feature-copy">
            <p class="eyebrow">01 / FERTIGE INSTRUMENTE</p>
            <h2>Die Gitarren</h2>
            <p>Jedes Instrument hat seinen eigenen Charakter. Entdecke die fertigen Gitarren, ihre Gestaltung, Materialien und besonderen konstruktiven Details.</p>
            <a class="text-link" href={guitarUrl}>Gitarren ansehen <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article class="home-feature home-feature-process">
          <a class="home-feature-image" href={processUrl}>
            {processImage && <Image src={processImage} alt={processStep?.title ? "Arbeitsschritt: " + processStep.title : "Einblick in den Gitarrenbau"} widths={[500, 800, 1100]} sizes="(max-width: 760px) 100vw, 42vw" loading="lazy" />}
          </a>
          <div class="home-feature-copy">
            <p class="eyebrow">02 / EINBLICKE IN DIE WERKSTATT</p>
            <h2>Der Bauprozess</h2>
            <p>Vom rohen Holz bis zum fertigen Klang: Bauberichte zeigen die Arbeitsschritte, technische Entscheidungen und Lösungen hinter den Instrumenten.</p>
            <a class="text-link" href={processUrl}>Bauberichte entdecken <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </section>

      <section class="home-about redesign-about">
        <div>
          <p class="eyebrow">Persönliches Projekt</p>
          <h2>Handwerk mit Freude am Tüfteln.</h2>
        </div>
        <div class="about-copy">
          <p>Grosche Guitars ist mein persönliches Gitarrenbauprojekt. Ich baue Instrumente aus Freude am Handwerk und an technischen Details – nicht als kommerzielle Gitarrenmarke, sondern als Hobby-Luthier mit dem Anspruch, eigene Ideen sorgfältig umzusetzen.</p>
          <p>Auf dieser Website halte ich fest, was dabei entsteht: fertige Gitarren, ausführliche Bauberichte, Werkstattprojekte und Lösungen, die vielleicht auch für andere Gitarrenbauer interessant sind.</p>
          <a class="text-link" href={base + "/ueber-mich/"}>Mehr über das Projekt <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
