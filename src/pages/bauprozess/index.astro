---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/guitars.css';

const guitars = await getCollection('guitars');
const ordered = [...guitars].sort((a,b)=>(a.data.order ?? 999)-(b.data.order ?? 999));
const images = import.meta.glob('/src/assets/images/guitars/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', {eager:true, import:'default'});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="de">
<head><Head title="Bauprozess | Grosche Guitars" description="Bauberichte und Einblicke in die Entstehung handgebauter Gitarren – vom Entwurf bis zum fertigen Instrument." /></head>
<body>
<Header />
<main class="editorial-page">
  <p class="eyebrow">Einblicke in die Entstehung</p>
  <h1>Der Bauprozess</h1>
  <p class="lead">Jede Gitarre ist eine Folge von Entscheidungen. Hier dokumentiere ich die einzelnen Schritte – mit Bildern, technischen Details, Umwegen und den Lösungen, die sich in der Werkstatt bewährt haben.</p>
  <div class="editorial-copy">
    <h2>Bauberichte</h2>
    <p>Die Berichte sind nach Instrumenten geordnet. So lässt sich der Weg vom ersten Holz bis zum fertigen Setup nachvollziehen. Die Gitarrenseiten zeigen dagegen die fertigen Instrumente und ihre Besonderheiten.</p>
  </div>
  <div class="guitar-grid">
  {ordered.map((guitar) => {
    const src = guitar.data.hero?.src;
    const image = src ? images[src] : undefined;
    return <article class="guitar-card">
      <a href={base + '/gitarren/' + guitar.id + '/'}>
        <div class="card-image">
          {image && <Image src={image} alt={guitar.data.hero?.alt || guitar.data.title} widths={[400,600,900]} sizes="(max-width:600px) calc(100vw - 36px), 520px" class="card-image-img" loading="lazy" />}
        </div>
        <div class="card-content">
          <h2>{guitar.data.title}</h2>
          {guitar.data.year && <p class="year">Baujahr {guitar.data.year}</p>}
          {guitar.data.description && <p class="description">{guitar.data.description}</p>}
          <span class="card-link">Baubericht öffnen →</span>
        </div>
      </a>
    </article>;
  })}
  </div>
  <section class="editorial-copy">
    <h2>Werkstatt und Konstruktionen</h2>
    <p>Viele Lösungen entstehen parallel zum Instrumentenbau. Selbst gebaute Vorrichtungen, Werkzeuge und kleine technische Experimente findest du im eigenen Bereich.</p>
    <a class="text-link" href={base + '/werkstatt/'}>Zu den Werkstattprojekten →</a>
  </section>
</main>
<Footer />
</body>
</html>
