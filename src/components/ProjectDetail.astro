---
import { Image } from 'astro:assets';
import Head from './Head.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/guitars.css';

interface Props {
  title: string;
  description?: string;
  year?: string | number;

  heroImage?: any;
  heroAlt?: string;
  heroDescription?: string;

  backHref: string;
  backLabel: string;
}

const {
  title,
  description,
  year,
  heroImage,
  heroAlt = '',
  heroDescription,
  backHref,
  backLabel
} = Astro.props;

const pageTitle = `${title} | Grosche Guitars`;
---

<!doctype html>

<html lang="de">

  <head>

    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <Head
      title={pageTitle}
    />

  </head>


  <body>

    <Header />


    <main class="guitar-detail">

      <a
        href={backHref}
        class="back"
      >
        ← {backLabel}
      </a>


      <h1>{title}</h1>


      {year && (
        <p class="year">
          Baujahr: {year}
        </p>
      )}


      {heroImage && (
        <figure class="project-hero">

          <Image
            src={heroImage}
            alt={heroAlt || title}
            class="hero"
            widths={[600, 900, 1200, 1600]}
            sizes="(max-width: 900px) 100vw, 1200px"
            loading="lazy"
          />

          {heroDescription && (
            <figcaption>
              {heroDescription}
            </figcaption>
          )}

        </figure>
      )}


      {description && (
        <p class="description">
          {description}
        </p>
      )}


      <div class="project-content">
        <slot />
      </div>

    </main>


    <Footer />

  </body>

</html>


<style>

  .project-hero {
    margin: 0 0 2rem;
  }

  .project-hero :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-hero figcaption {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .project-content {
    line-height: 1.7;
  }

  .project-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .project-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .project-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .project-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

</style>
