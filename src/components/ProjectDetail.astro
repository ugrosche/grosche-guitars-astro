---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;

  heroImage?: any;
  heroAlt?: string;
  heroDescription?: string;

  backHref: string;
  backLabel: string;
}

const {
  title,
  description,
  heroImage,
  heroAlt = '',
  heroDescription,
  backHref,
  backLabel
} = Astro.props;
---

<main class="project-detail">

  <a
    class="back-link"
    href={backHref}
  >
    ← {backLabel}
  </a>

  <article>

    <header class="project-header">

      <h1>{title}</h1>

      {description && (
        <p class="project-description">
          {description}
        </p>
      )}

    </header>


    {heroImage && (
      <figure class="project-hero">

        <Image
          src={heroImage}
          alt={heroAlt || title}
          widths={[600, 900, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 1200px"
        />

        {heroDescription && (
          <figcaption>
            {heroDescription}
          </figcaption>
        )}

      </figure>
    )}


    <div class="project-content">
      <slot />
    </div>

  </article>

</main>


<style>

  .project-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }


  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: inherit;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }


  .project-header {
    margin-bottom: 2rem;
  }

  .project-header h1 {
    margin: 0 0 0.75rem;
  }

  .project-description {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.6;
  }


  .project-hero {
    margin: 0 0 3rem;
  }

  .project-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .project-hero figcaption {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }


  .project-content {
    max-width: 850px;
    line-height: 1.7;
  }

  .project-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .project-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .project-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .project-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }


  @media (max-width: 700px) {

    .project-detail {
      padding: 1.25rem 1rem 3rem;
    }

    .project-description {
      font-size: 1.05rem;
    }

  }

</style>
`
