---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const homeUrl = base + "/";
const guitarsUrl = base + "/gitarren/";
const workshopUrl = base + "/werkstatt/";
const logoUrl = base + "/favicon.png";

const pathname = Astro.url.pathname;

const homeClass = pathname === homeUrl ? "active" : "";
const guitarsClass = pathname.startsWith(guitarsUrl) ? "active" : "";
const workshopClass = pathname.startsWith(workshopUrl) ? "active" : "";
---

<header class="site-header">
  <div class="site-header-inner">

    <a href={homeUrl} class="site-logo">
      <img src={logoUrl} alt="" class="site-logo-image" />
      <span>Grosche Guitars</span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">

      <a href={homeUrl} class={homeClass}>
        Startseite
      </a>

      <a href={guitarsUrl} class={guitarsClass}>
        Gitarren
      </a>

      <a href={workshopUrl} class={workshopClass}>
        Werkstatt
      </a>

    </nav>

  </div>
</header>
